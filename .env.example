# Default: Cloudflare Workers AI feature analysis + original text-to-image.
# Copy to .env and fill credentials locally. Never share or commit .env.
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/moondream/moondream3.1-9B-A2B
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# Optional: set AI_PROVIDER=comfyui to use the existing ComfyUI adapter.
COMFY_URL=http://127.0.0.1:8188
COMFY_API_KEY=
COMFY_TIMEOUT=900
COMFY_WIDTH=512
COMFY_HEIGHT=640
COMFY_STEPS=24
COMFY_CFG=6.5
CLOUDFLARE_VIDEO_MODEL=pixverse/v6

